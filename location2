<!DOCTYPE html>
<html lang="uk" translate="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google" content="notranslate" />
  <title>Локація 2 — День хрещення</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      font-family: Georgia, "Times New Roman", serif;
      color: #76418f;
      background: linear-gradient(180deg, #fff2fb 0%, #f5e4ff 100%);
      overflow-x: hidden;
    }

    body {
      min-height: 100vh;
    }

    .page {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
      padding: 18px 14px 34px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    .top-btn {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: 2px solid rgba(238, 219, 127, 0.9);
      background: rgba(255, 255, 255, 0.78);
      color: #76418f;
      font-size: 28px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(120, 70, 150, 0.16);
    }

    .location-title {
      padding: 10px 22px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.78);
      border: 2px solid rgba(238, 219, 127, 0.9);
      font-size: 22px;
      font-weight: 700;
      box-shadow: 0 8px 18px rgba(120, 70, 150, 0.12);
    }

    .card {
      border-radius: 28px;
      border: 2px solid rgba(238, 219, 127, 0.82);
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 12px 26px rgba(120, 70, 150, 0.14);
      padding: 22px 18px;
      margin-bottom: 18px;
      text-align: center;
    }

    .hero h1 {
      margin: 0 0 12px;
      font-size: 42px;
      line-height: 0.95;
    }

    .hero p {
      margin: 0;
      font-size: 22px;
      line-height: 1.25;
      font-weight: 600;
    }

    .task-title {
      font-size: 26px;
      line-height: 1.15;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .counter {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-width: 150px;
      padding: 8px 18px;
      border-radius: 999px;
      background: rgba(255, 245, 252, 0.9);
      font-size: 21px;
      font-weight: 700;
    }

    .moments {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .moment-card {
      position: relative;
      border-radius: 24px;
      border: 2px dashed rgba(150, 100, 180, 0.35);
      background: rgba(255, 255, 255, 0.76);
      min-height: 130px;
      padding: 18px 58px 18px 18px;
      text-align: left;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(120, 70, 150, 0.1);
      transition: 0.18s ease;
    }

    .moment-card.selected {
      border-style: solid;
      border-color: rgba(238, 190, 90, 0.95);
      background: rgba(255, 248, 230, 0.9);
      box-shadow:
        0 0 0 2px rgba(255, 238, 160, 0.7),
        0 10px 22px rgba(120, 70, 150, 0.16);
      transform: translateY(-1px);
    }

    .moment-card h3 {
      margin: 0 0 8px;
      font-size: 25px;
      line-height: 1;
    }

    .moment-card p {
      margin: 0;
      font-size: 18px;
      line-height: 1.25;
      font-weight: 600;
      color: #856096;
    }

    .check {
      position: absolute;
      right: 14px;
      top: 14px;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: none;
      background: rgba(255, 235, 248, 0.95);
      color: #76418f;
      font-size: 22px;
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(120, 70, 150, 0.14);
    }

    .moment-card.selected .check {
      background: #d84d86;
      color: #ffffff;
    }

    .finish-card {
      display: none;
    }

    .finish-card.active {
      display: block;
    }

    .finish-title {
      font-size: 30px;
      line-height: 1;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .finish-text {
      font-size: 20px;
      line-height: 1.25;
      font-weight: 600;
      margin-bottom: 16px;
    }

    .finish-btn {
      width: 100%;
      border: none;
      border-radius: 999px;
      padding: 14px 18px;
      background: linear-gradient(180deg, #c78be5, #a96bd1);
      color: #ffffff;
      font-size: 23px;
      font-weight: 700;
      font-family: Georgia, "Times New Roman", serif;
      cursor: pointer;
      box-shadow: 0 10px 22px rgba(120, 70, 150, 0.2);
    }

    .finish-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      background: linear-gradient(180deg, #ddd5dd, #bfb6bf);
    }

    .small-note {
      margin-top: 12px;
      font-size: 16px;
      color: #8b6e9c;
      font-weight: 600;
    }
  </style>
</head>

<body class="notranslate">

  <main class="page">

    <div class="topbar">
      <button class="top-btn" type="button" id="backBtn">←</button>
      <div class="location-title">Локація 2</div>
      <button class="top-btn" type="button" id="musicBtn">♪</button>
    </div>

    <section class="card hero">
      <h1>День<br>хрещення</h1>
      <p>
        Це друга зупинка нашої чарівної подорожі. Тут ми згадаємо особливий день,
        наповнений теплом, любов’ю та благословенням.
      </p>
    </section>

    <section class="card">
      <div class="task-title">Обери 3 найважливіші моменти цього дня 💜</div>
      <div class="counter" id="counter">Обрано 0 з 3</div>
    </section>

    <section class="moments" id="moments">
      <div class="moment-card" data-id="moment-1">
        <button class="check" type="button">♡</button>
        <h3>Перший світлий момент</h3>
        <p>Сюди пізніше вставимо фото або опис важливого кадру з хрещення.</p>
      </div>

      <div class="moment-card" data-id="moment-2">
        <button class="check" type="button">♡</button>
        <h3>Родинне тепло</h3>
        <p>Тут буде місце для фото з рідними, хрещеними або особливими гостями.</p>
      </div>

      <div class="moment-card" data-id="moment-3">
        <button class="check" type="button">♡</button>
        <h3>Ніжний образ Софійки</h3>
        <p>Пізніше тут можна додати фото Софійки у святковому вбранні.</p>
      </div>

      <div class="moment-card" data-id="moment-4">
        <button class="check" type="button">♡</button>
        <h3>Святкова атмосфера</h3>
        <p>Місце для кадру храму, декору, свічки, квітів або красивої деталі.</p>
      </div>

      <div class="moment-card" data-id="moment-5">
        <button class="check" type="button">♡</button>
        <h3>Особлива посмішка</h3>
        <p>Тут буде фото або милий момент, який хочеться запам’ятати.</p>
      </div>

      <div class="moment-card" data-id="moment-6">
        <button class="check" type="button">♡</button>
        <h3>Пам’ятний кадр</h3>
        <p>Сюди додамо ще один важливий спогад із цього дня.</p>
      </div>
    </section>

    <section class="card finish-card" id="finishCard">
      <div class="finish-title">Локацію 2 пройдено!</div>
      <div class="finish-text">
        Ти відкрив наступну частину чарівної подорожі Софійки.
      </div>
      <button class="finish-btn" type="button" id="finishBtn">
        Повернутися на карту
      </button>
      <div class="small-note">Після цього відкриється 3 локація</div>
    </section>

  </main>

  <audio id="bgMusic" loop preload="auto">
    <source src="solarflex-magic-fantasy-fairy-tale-music-495646.mp3" type="audio/mpeg">
    <source src="music.mp3" type="audio/mpeg">
  </audio>

  <script>
    const maxSelected = 3;
    const selected = new Set();

    const counter = document.getElementById("counter");
    const finishCard = document.getElementById("finishCard");
    const finishBtn = document.getElementById("finishBtn");
    const backBtn = document.getElementById("backBtn");
    const musicBtn = document.getElementById("musicBtn");
    const bgMusic = document.getElementById("bgMusic");

    if (bgMusic) {
      bgMusic.volume = 0.35;
    }

    function updateCounter() {
      counter.textContent = "Обрано " + selected.size + " з " + maxSelected;

      if (selected.size === maxSelected) {
        finishCard.classList.add("active");

        setTimeout(function() {
          finishCard.scrollIntoView({
            behavior: "smooth",
            block: "center"
          });
        }, 250);
      } else {
        finishCard.classList.remove("active");
      }
    }

    function toggleMoment(card) {
      const id = card.getAttribute("data-id");
      const btn = card.querySelector(".check");

      if (selected.has(id)) {
        selected.delete(id);
        card.classList.remove("selected");
        btn.textContent = "♡";
        updateCounter();
        return;
      }

      if (selected.size >= maxSelected) {
        alert("Можна обрати тільки 3 моменти 💜");
        return;
      }

      selected.add(id);
      card.classList.add("selected");
      btn.textContent = "❤";
      updateCounter();
    }

    document.addEventListener("click", function(event) {
      const card = event.target.closest(".moment-card");

      if (!card) return;

      event.preventDefault();
      event.stopPropagation();

      toggleMoment(card);
    });

    finishBtn.addEventListener("click", function() {
      localStorage.setItem("sofiyka_location2_done", "true");
      window.location.href = "map.html";
    });

    backBtn.addEventListener("click", function() {
      window.location.href = "map.html";
    });

    musicBtn.addEventListener("click", async function() {
      if (!bgMusic) return;

      try {
        if (bgMusic.paused) {
          await bgMusic.play();
          musicBtn.classList.add("playing");
          localStorage.setItem("sofiyka_music", "on");
        } else {
          bgMusic.pause();
          musicBtn.classList.remove("playing");
          localStorage.setItem("sofiyka_music", "off");
        }
      } catch (error) {
        alert("Музика не запустилась. Перевір mp3 файл 🎵");
      }
    });

    updateCounter();
  </script>

</body>
</html>
